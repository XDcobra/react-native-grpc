{
  "name": "@xdcobra/react-native-grpc",
  "version": "1.0.0",
  "description": "gRPC for react-native (fork of @krishnafkh/react-native-grpc / Mitch528)",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "module": "./lib/module/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./create-client": {
      "react-native": "./src/create-client.ts",
      "types": "./lib/typescript/create-client.d.ts",
      "module": "./lib/module/create-client.js",
      "default": "./lib/commonjs/create-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-grpc.podspec",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/node_modules",
    "!android/build",
    "!android/.project",
    "!android/.settings",
    "!android/.gradle",
    "!ios/build",
    "!ios/Grpc.xcodeproj"
  ],
  "scripts": {
    "test": "jest",
    "typescript": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint '**/*.{js,ts,tsx}' --fix",
    "build": "bob build",
    "prepare": "bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "pods": "cd example && pod-install --quiet",
    "bootstrap": "yarn example && yarn && yarn pods"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "grpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XDcobra/react-native-grpc.git"
  },
  "author": "XDcobra (fork; original Krishna / Mitch528)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/XDcobra/react-native-grpc/issues"
  },
  "homepage": "https://github.com/XDcobra/react-native-grpc#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@react-native-community/eslint-config": "^3.0.0",
    "@release-it/keep-a-changelog": "^3.0.0",
    "@types/jest": "^26.0.23",
    "@types/react": "^17.0.11",
    "@types/react-native": "0.70.6",
    "commitlint": "^12.1.4",
    "eslint": "^7.29.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "husky": "^4.3.8",
    "jest": "^26.6.3",
    "pod-install": "^0.1.23",
    "prettier": "^2.3.1",
    "react": "17.0.2",
    "react-native": "0.70.6",
    "react-native-builder-bob": "^0.20.1",
    "release-it": "^15.0.0",
    "typescript": "^5.7.3",
    "xcode": "^3.0.1"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "jest": {
    "preset": "react-native",
    "testMatch": [
      "**/__tests__/**/*.(test|spec).[jt]s?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "moduleNameMapper": {
      "^@bufbuild/protobuf/codegenv2$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/codegenv2/index.js",
      "^@bufbuild/protobuf/codegenv1$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/codegenv1/index.js",
      "^@bufbuild/protobuf/reflect$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/reflect/index.js",
      "^@bufbuild/protobuf/wkt$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/wkt/index.js",
      "^@bufbuild/protobuf/wire$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/wire/index.js",
      "^@bufbuild/protobuf$": "<rootDir>/node_modules/@bufbuild/protobuf/dist/commonjs/index.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@bufbuild)/)"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "yarn lint && yarn typescript"
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "allowEmptyCommit": true,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": false
    },
    "plugins": {
      "@release-it/keep-a-changelog": {
        "filename": "CHANGELOG.md"
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native-community",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/",
    "example/src/_proto/",
    "example/src/gen/",
    "src/__fixtures__/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "endOfLine": "auto"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "dependencies": {
    "abort-controller": "^3.0.0",
    "base64-js": "^1.5.1",
    "eventemitter3": "^4.0.7"
  }
}
